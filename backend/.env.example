# Local development only. Never commit your real .env.
# Ledger/Tax connection; DB_* below are not read by its Database service.
DATABASE_URL=postgresql://dt13:change_me@localhost:5432/dt13
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=taxbook-pos
JWT_AUDIENCE=taxbook-pos-api
# Relative to backend/ when running npm start.
TAX_CONFIG_DIR=../config/tax

# Shared backend configuration examples from Quang Dung.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dt13
DB_USER=dt13
DB_PASSWORD=change_me
